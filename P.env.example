# Copie ce fichier vers .env pour une exécution locale.
# Ne committe jamais le fichier .env réel.

NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

VINTED_BASE_URL=https://www.vinted.be
VINTED_DATA_DIR=runtime_data
VINTED_LOG_LEVEL=INFO
VINTED_MAX_LISTING_AGE_HOURS=24
VINTED_REJECT_UNKNOWN_LISTING_AGE=true
VINTED_REQUEST_DELAY_MIN_SECONDS=1.0
VINTED_REQUEST_DELAY_MAX_SECONDS=3.0
VINTED_STARTUP_JITTER_MAX_SECONDS=20
VINTED_RUN_BUDGET_SECONDS=480
VINTED_MAX_ITEMS_PER_SEARCH=15
HEADLESS=1
